{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TRIANGLES_BUILD_APP": true,
        "BUILD_TESTING": true,
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{GENERAL_FUNCTIONS_CLANG_SCAN_DEPS}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug application and tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release application and tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile",
      "displayName": "Optimized application with debug symbols",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": false
      }
    },
    {
      "name": "quality",
      "displayName": "Compilation database for clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "jobs": 2
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
